# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Use Vertex AI (billed to your Cloud billing account, so GCP credits apply) instead of the AI Studio API:
# GEMINI_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=your-project-id      # with a service-account key, or leave empty to use a Vertex API key above
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Tiger Data: `tiger db uri --with-password`
DATABASE_URL=

# Fallbacks when the main model is overloaded (503) or out of quota (429), tried in order
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_S=60

# Accounts and live data (defaults shown)
# ENABLE_DEMO_LOGIN=1        # "Try the demo" buttons on /login
# LIVE_OUTAGES=1             # import DTE's public outage map every 10 minutes
# EXTRA_OUTAGE_FEEDS=        # more Kubra StormCenter utilities: "Name:instanceId:viewId;..."

# Demo sign-in accounts created by setup_db.py / migrate.py (choose your own passwords)
# DEMO_OWNER_EMAIL=owner@lifelog.example
# DEMO_OWNER_PASSWORD=
# DEMO_CUSTOMER_EMAIL=customer@lifelog.example
# DEMO_CUSTOMER_PASSWORD=
# DEMO_PHARMACIST_EMAIL=pharmacist@lifelog.example
# DEMO_PHARMACIST_PASSWORD=

# Public address for QR codes and shared links (scripts/run_public.py sets it for you)
# PUBLIC_URL=https://your-lifelog-url
